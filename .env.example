# Optional. Without any key the app runs in replay mode — a recorded generation
# streamed through the exact same code path, at zero cost.
#
# Provider precedence: ANTHROPIC_API_KEY (direct, schema-enforced output),
# then OPENROUTER_API_KEY (OpenAI-compatible gateway, prompt-enforced output).
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional model override for live mode.
# Direct Anthropic default: claude-opus-4-8
# OpenRouter default:       anthropic/claude-opus-4.8
BRAND_MODEL=
